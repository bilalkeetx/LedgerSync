@model LedgerSync.Web.Models.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set New Password";
    var demoToken = TempData["DemoToken"]?.ToString();
}

<div class="text-center text-sm-start mb-3">
    <h4 class="fw-bold text-dark mb-1">Set New Password</h4>
    <p class="text-muted small mb-0">Enter the verification token and choose a secure password.</p>
</div>

@if (!string.IsNullOrEmpty(demoToken))
{
    <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill text-info fs-5 flex-shrink-0"></i>
        <div>
            <span>Test Token: <strong class="font-monospace text-dark">@demoToken</strong> (Preloaded for simulation)</span>
        </div>
    </div>
}

<form method="post" asp-controller="Account" asp-action="ResetPassword" novalidate>
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="resetEmail" class="form-label small fw-semibold">Corporate Email</label>
        <input type="email" 
               class="form-control bg-light" 
               id="resetEmail" 
               asp-for="Email" 
               readonly />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label for="resetToken" class="form-label small fw-semibold">Verification Token / Code</label>
        <input type="text" 
               class="form-control font-monospace fw-bold" 
               id="resetToken" 
               asp-for="Token" 
               value="@(demoToken ?? "")"
               placeholder="e.g. 8A49C102" 
               required />
        <span asp-validation-for="Token" class="text-danger small"></span>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-12 col-md-6">
            <label for="newPassword" class="form-label small fw-semibold">New Password</label>
            <input type="password" 
                   class="form-control" 
                   id="newPassword" 
                   asp-for="NewPassword" 
                   placeholder="••••••••" 
                   required 
                   autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="col-12 col-md-6">
            <label for="confirmNewPassword" class="form-label small fw-semibold">Confirm Password</label>
            <input type="password" 
                   class="form-control" 
                   id="confirmNewPassword" 
                   asp-for="ConfirmPassword" 
                   placeholder="••••••••" 
                   required 
                   autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold shadow-sm mb-3">
        Update Password &amp; Sign In
    </button>
</form>

<div class="text-center mt-3 pt-3 border-top small">
    <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold">Cancel and Return</a>
</div>