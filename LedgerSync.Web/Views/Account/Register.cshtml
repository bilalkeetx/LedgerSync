@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register Tenant Firm";
}

<h5 class="fw-bold text-dark mb-1">Register Firm / Tenant</h5>
<p class="text-muted small mb-4">Join LedgerSync bilateral trading & tally network</p>

<form method="post" asp-controller="Account" asp-action="Register">
    <div class="mb-3">
        <label class="form-label small fw-semibold">Firm Legal Name</label>
        <input type="text" class="form-control" placeholder="e.g. Sabir Vegetable Oil" required />
    </div>

    <div class="mb-3">
        <label class="form-label small fw-semibold">National Tax / Sales Tax ID (NTN / STRN)</label>
        <input type="text" class="form-control" placeholder="e.g. 1428590-7" required />
    </div>

    <div class="mb-3">
        <label class="form-label small fw-semibold">Work / Corporate Email</label>
        <input type="email" class="form-control" placeholder="procurement@firm.com.pk" required />
    </div>

    <div class="row g-2 mb-3">
        <div class="col-sm-6">
            <label class="form-label small fw-semibold">Password</label>
            <input type="password" class="form-control" placeholder="••••••••" required />
        </div>
        <div class="col-sm-6">
            <label class="form-label small fw-semibold">Confirm Password</label>
            <input type="password" class="form-control" placeholder="••••••••" required />
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-sm-6">
            <label class="form-label small fw-semibold">Fiscal Period</label>
            <select class="form-select">
                <option selected>FY 2026-2027</option>
                <option>FY 2025-2026</option>
            </select>
        </div>
        <div class="col-sm-6">
            <label class="form-label small fw-semibold">Primary Role</label>
            <select class="form-select">
                <option selected>Tenant Admin</option>
                <option>Broker Operator</option>
                <option>Accountant</option>
            </select>
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="terms" required checked />
        <label class="form-check-label small text-muted" for="terms">
            Acknowledge adherence to standard bilateral settlement rules.
        </label>
    </div>

    <button type="submit" class="btn btn-dark w-100 py-2 fw-medium">Register & Provision Firm</button>
</form>

<div class="text-center mt-3 pt-3 border-top small">
    <span class="text-muted">Already registered?</span>
    <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold">Sign in here</a>
</div>