@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register Tenant Firm";
}

<div class="text-center text-sm-start mb-4">
    <h4 class="fw-bold text-dark mb-1">Register Firm / Tenant</h4>
    <p class="text-muted small mb-0">Create your tenant account to access LedgerSync desks.</p>
</div>

<form method="post" asp-controller="Account" asp-action="Register" novalidate>
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="firmName" class="form-label small fw-semibold">Firm Legal Name</label>
        <input type="text" 
               class="form-control" 
               id="firmName" 
               name="FirmName" 
               placeholder="e.g. Sabir Vegetable Oil" 
               autocomplete="organization" 
               required />
    </div>

    <div class="mb-3">
        <label for="taxId" class="form-label small fw-semibold">National Tax / Sales Tax ID (NTN / STRN)</label>
        <input type="text" 
               class="form-control" 
               id="taxId" 
               name="TaxId" 
               placeholder="e.g. 1428590-7" 
               required />
    </div>

    <div class="mb-3">
        <label for="corporateEmail" class="form-label small fw-semibold">Corporate Email</label>
        <input type="email" 
               class="form-control" 
               id="corporateEmail" 
               name="Email" 
               placeholder="procurement@firm.com.pk" 
               autocomplete="email" 
               required />
    </div>

    <div class="row g-2 mb-3">
        <div class="col-12 col-md-6">
            <label for="registerPassword" class="form-label small fw-semibold">Password</label>
            <input type="password" 
                   class="form-control" 
                   id="registerPassword" 
                   name="Password" 
                   placeholder="••••••••" 
                   autocomplete="new-password" 
                   required />
        </div>
        <div class="col-12 col-md-6">
            <label for="confirmPassword" class="form-label small fw-semibold">Confirm Password</label>
            <input type="password" 
                   class="form-control" 
                   id="confirmPassword" 
                   name="ConfirmPassword" 
                   placeholder="••••••••" 
                   autocomplete="new-password" 
                   required />
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-12 col-md-6">
            <label for="registerFiscalPeriod" class="form-label small fw-semibold">Fiscal Period</label>
            <select class="form-select" id="registerFiscalPeriod" name="FiscalPeriod">
                <option selected value="2026-2027">FY 2026-2027</option>
                <option value="2025-2026">FY 2025-2026</option>
            </select>
        </div>
        <div class="col-12 col-md-6">
            <label for="primaryRole" class="form-label small fw-semibold">Primary Role</label>
            <select class="form-select" id="primaryRole" name="Role">
                <option selected value="TenantAdmin">Tenant Admin</option>
                <option value="BrokerOperator">Broker Operator</option>
                <option value="Accountant">Accountant</option>
            </select>
        </div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="termsCheck" name="AgreeToTerms" value="true" required checked />
        <label class="form-check-label small text-muted" for="termsCheck">
            I acknowledge adherence to standard bilateral settlement rules.
        </label>
    </div>

    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold shadow-sm">
        Register & Provision Firm
    </button>
</form>

<div class="text-center mt-4 pt-3 border-top small">
    <span class="text-muted">Already registered?</span>
    <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold ms-1">Sign in here</a>
</div>