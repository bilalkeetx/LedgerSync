@{
    ViewData["Title"] = "Institutional Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">

            <!-- Authentication Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden ls-card">
                
                <!-- Card Header -->
                <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0b0f19 90%);">
                    <div class="d-inline-flex align-items-center justify-content-center mb-2">
                        <span class="navbar-brand-badge" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-intersect"></i>
                        </span>
                    </div>
                    <h4 class="fw-bold text-white mb-1">Institutional Sign In</h4>
                    <p class="text-secondary small mb-0">Dual-Party Settlement &amp; Continuous Ledger Sync</p>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-sm-5 bg-white">
                    <form method="post" asp-controller="Account" asp-action="Login" novalidate>
                        
                        <!-- Email Input -->
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label fw-semibold text-dark small mb-1">
                                Institutional Work Email
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" class="form-control bg-light border-start-0" id="loginEmail" name="Email" placeholder="trader@alphacapital.com" required autocomplete="username" />
                            </div>
                            <div class="form-text text-muted small">Registered institutional tenant email.</div>
                        </div>

                        <!-- Password Input -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="loginPassword" class="form-label fw-semibold text-dark small mb-0">
                                    Password
                                </label>
                                <a href="#forgot" class="text-decoration-none small text-primary" tabindex="-1">Forgot password?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-key"></i>
                                </span>
                                <input type="password" class="form-control bg-light border-start-0 border-end-0" id="loginPassword" name="Password" placeholder="••••••••••••" required autocomplete="current-password" />
                                <button class="btn btn-outline-secondary border-start-0 bg-light text-secondary" type="button" id="togglePasswordBtn" aria-label="Toggle password visibility">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Fiscal Accounting Year Selector -->
                        <div class="mb-3">
                            <label for="fiscalYearSelect" class="form-label fw-semibold text-dark small mb-1">
                                Fiscal Accounting Year
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-calendar-range"></i>
                                </span>
                                <select class="form-select bg-light border-start-0" id="fiscalYearSelect" name="FiscalYear" required>
                                    <option value="FY 2026-2027" selected>FY 2026-2027 (Active Audit &amp; Settlement Period)</option>
                                    <option value="FY 2025-2026">FY 2025-2026 (Audited Historical Ledger)</option>
                                    <option value="FY 2024-2025">FY 2024-2025 (Archived Period)</option>
                                    <option value="FY 2027-2028">FY 2027-2028 (Upcoming Forward Tenors)</option>
                                </select>
                            </div>
                            <div class="form-text text-muted small">Sets active tally and reconciliation book scope.</div>
                        </div>

                        <!-- Role Selection Dropdown -->
                        <div class="mb-4">
                            <label for="roleSelect" class="form-label fw-semibold text-dark small mb-1">
                                Operating Role
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-person-badge"></i>
                                </span>
                                <select class="form-select bg-light border-start-0" id="roleSelect" name="Role" required>
                                    <option value="Admin">Admin (Tenant Management &amp; Security Officer)</option>
                                    <option value="Broker Operator" selected>Broker Operator (Deal Capture &amp; Trade Desk)</option>
                                    <option value="Accountant">Accountant (Tally Desk &amp; Ledger Reconciliation)</option>
                                </select>
                            </div>
                            <div class="form-text text-muted small">Access privileges configured for your assigned workstation.</div>
                        </div>

                        <!-- Remember Me & Security Check -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMeCheck" name="RememberMe" />
                                <label class="form-check-label small text-secondary" for="rememberMeCheck">
                                    Remember session on this device
                                </label>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle small px-2 py-1">
                                <i class="bi bi-shield-check me-1"></i> 2FA Enforced
                            </span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Sign In to Desk</span>
                        </button>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light p-3 text-center border-top small">
                    <span class="text-secondary">New counterparty or institution?</span>
                    <a asp-controller="Account" asp-action="Register" class="fw-semibold text-primary text-decoration-none ms-1">
                        Register Tenant Organization
                    </a>
                </div>
            </div>

            <!-- Security Assurance Note -->
            <div class="text-center mt-3 text-secondary small">
                <i class="bi bi-lock-fill me-1 text-muted"></i>
                <span>Encrypted with TLS 1.3 &bull; Mutual TLS (mTLS) Attestation Required</span>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passwordInput = document.getElementById('loginPassword');
            const toggleIcon = document.getElementById('togglePasswordIcon');

            if (toggleBtn && passwordInput && toggleIcon) {
                toggleBtn.addEventListener('click', function () {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    toggleIcon.classList.toggle('bi-eye', !isPassword);
                    toggleIcon.classList.toggle('bi-eye-slash', isPassword);
                });
            }
        });
    </script>
}
