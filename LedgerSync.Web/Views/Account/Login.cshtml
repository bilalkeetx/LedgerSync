@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Institutional Sign In";
}

<div class="text-center text-sm-start mb-4">
    <h4 class="fw-bold text-dark mb-1">Sign In to Desk</h4>
    <p class="text-muted small mb-0">Enter your credentials to access the operational desk.</p>
</div>

<form method="post" asp-controller="Account" asp-action="Login" novalidate>
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="emailInput" class="form-label small fw-semibold">Official Email</label>
        <input type="email" 
               class="form-control" 
               id="emailInput" 
               name="Email" 
               placeholder="name@firm.com" 
               autocomplete="email" 
               required />
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="passwordInput" class="form-label small fw-semibold mb-0">Password</label>
            <a href="#" class="small text-decoration-none text-secondary">Forgot?</a>
        </div>
        <input type="password" 
               class="form-control" 
               id="passwordInput" 
               name="Password" 
               placeholder="••••••••" 
               autocomplete="current-password" 
               required />
    </div>

    <div class="row g-2 mb-3">
        <div class="col-12 col-sm-6">
            <label for="fiscalPeriodSelect" class="form-label small fw-semibold">Fiscal Period</label>
            <select class="form-select" id="fiscalPeriodSelect" name="FiscalPeriod">
                <option selected value="2026-2027">FY 2026-2027</option>
                <option value="2025-2026">FY 2025-2026</option>
            </select>
        </div>
        <div class="col-12 col-sm-6">
            <label for="roleSelect" class="form-label small fw-semibold">Operating Role</label>
            <select class="form-select" id="roleSelect" name="Role">
                <option selected value="BrokerOperator">Broker Operator</option>
                <option value="Accountant">Accountant</option>
                <option value="TenantAdmin">Tenant Admin</option>
            </select>
        </div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" value="true" checked />
        <label class="form-check-label small text-muted" for="rememberMe">
            Remember session on this device
        </label>
    </div>

    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold shadow-sm">
        Sign In to Desk
    </button>
</form>

<div class="text-center mt-4 pt-3 border-top small">
    <span class="text-muted">Need a new firm desk?</span>
    <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold ms-1">Register here</a>
</div>