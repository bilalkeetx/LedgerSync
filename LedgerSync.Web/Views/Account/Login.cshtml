@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Institutional Sign In";
}

<h5 class="fw-bold text-dark mb-1">Sign In to Desk</h5>
<p class="text-muted small mb-4">Enter credentials to access trading & tally desks</p>

<form method="post" asp-controller="Account" asp-action="Login">
    <div class="mb-3">
        <label class="form-label small fw-semibold">Official Email</label>
        <input type="email" class="form-control" placeholder="trader@firm.com.pk" required />
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center">
            <label class="form-label small fw-semibold mb-0">Password</label>
            <a href="#" class="small text-muted text-decoration-none">Forgot?</a>
        </div>
        <input type="password" class="form-control mt-1" placeholder="••••••••" required />
    </div>

    <div class="row g-2 mb-3">
        <div class="col-sm-6">
            <label class="form-label small fw-semibold">Fiscal Period</label>
            <select class="form-select">
                <option selected>FY 2026-2027</option>
                <option>FY 2025-2026</option>
            </select>
        </div>
        <div class="col-sm-6">
            <label class="form-label small fw-semibold">Operating Role</label>
            <select class="form-select">
                <option selected>Broker Operator</option>
                <option>Accountant</option>
                <option>Tenant Admin</option>
            </select>
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="remember" checked />
        <label class="form-check-label small text-muted" for="remember">Remember session on this device</label>
    </div>

    <button type="submit" class="btn btn-dark w-100 py-2 fw-medium">Sign In to Desk</button>
</form>

<div class="text-center mt-3 pt-3 border-top small">
    <span class="text-muted">Need a new firm desk?</span>
    <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
</div>