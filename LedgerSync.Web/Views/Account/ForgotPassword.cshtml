@model LedgerSync.Web.Models.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="text-center text-sm-start mb-4">
    <h4 class="fw-bold text-dark mb-1">Reset Desk Password</h4>
    <p class="text-muted small mb-0">Enter your registered corporate email to receive a reset token.</p>
</div>

<form method="post" asp-controller="Account" asp-action="ForgotPassword" novalidate>
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="recoveryEmail" class="form-label small fw-semibold">Corporate Email Address</label>
        <div class="input-group">
            <span class="input-group-text bg-light text-secondary border-end-0">
                <i class="bi bi-envelope"></i>
            </span>
            <input type="email" 
                   class="form-control border-start-0" 
                   id="recoveryEmail" 
                   asp-for="Email" 
                   placeholder="procurement@firm.com.pk" 
                   required 
                   autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold shadow-sm mb-3">
        Generate Reset Token
    </button>
</form>

<div class="text-center mt-3 pt-3 border-top small">
    <span class="text-muted">Remembered your password?</span>
    <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold ms-1">Return to Sign In</a>
</div>