@model dynamic
@{
    ViewData["Title"] = "Dual-Party Trade Capture";
}

<div class="container-fluid px-2 px-md-3 px-lg-4 py-3 py-md-4">

    <!-- Header & Quick Nav -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Deals" asp-action="Index" class="text-decoration-none">Deal Desk</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Capture</li>
                </ol>
            </nav>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="h3 fw-bold text-dark mb-0">Dual-Party Deal Capture</h1>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Active Intake</span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill flex-grow-1 flex-md-grow-0" id="btnFillDemoDeal">
                <i class="bi bi-magic me-1 text-primary"></i> Preload Sample
            </button>
            <a class="btn btn-outline-primary btn-sm px-3 rounded-pill d-flex align-items-center justify-content-center gap-1 flex-grow-1 flex-md-grow-0" asp-controller="Reconciliation" asp-action="Index">
                <i class="bi bi-arrow-left-right"></i>
                <span>Tally Desk</span>
            </a>
        </div>
    </div>

    <form method="post" asp-controller="Deals" asp-action="Create" id="dealCaptureForm" novalidate>
        @Html.AntiForgeryToken()
        
        <!-- Universal Contract Identifiers -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-dark text-white px-3 px-md-4 py-3 border-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-primary"></i>
                    <span class="fw-semibold small text-uppercase tracking-wider">Contract &amp; Logistics Identifiers</span>
                </div>
                <span class="badge bg-secondary-subtle text-light small font-monospace">PROTOCOL: DUAL-V1</span>
            </div>

            <div class="card-body p-3 p-md-4 bg-white">
                <div class="row g-3">
                    
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="doNumber" class="form-label fw-semibold text-dark small mb-1">
                            Delivery Order (D.O. #) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-secondary border-end-0">
                                <i class="bi bi-receipt"></i>
                            </span>
                            <input type="text" class="form-control bg-light border-start-0 font-monospace fw-bold" id="doNumber" name="DoNumber" placeholder="DO-2026-8849" value="DO-2026-8849" required />
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="truckNumber" class="form-label fw-semibold text-dark small mb-1">
                            Vehicle / Truck # <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-secondary border-end-0">
                                <i class="bi bi-truck"></i>
                            </span>
                            <input type="text" class="form-control bg-light border-start-0 font-monospace fw-bold" id="truckNumber" name="TruckNumber" placeholder="TKP-841 (Multan)" value="TKP-841 (Multan)" required />
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="transporter" class="form-label fw-semibold text-dark small mb-1">
                            Transporter <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-secondary border-end-0">
                                <i class="bi bi-box-seam"></i>
                            </span>
                            <input type="text" class="form-control bg-light border-start-0" id="transporter" name="Transporter" placeholder="Transport Agency" value="Malik Goods Transport Agency" required />
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="itemCommodity" class="form-label fw-semibold text-dark small mb-1">
                            Commodity Specification <span class="text-danger">*</span>
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-secondary border-end-0">
                                <i class="bi bi-tag"></i>
                            </span>
                            <input type="text" class="form-control bg-light border-start-0" id="itemCommodity" name="Item" placeholder="e.g. Soya Meal" value="Soyabean Seed Meal (Hi-Pro)" required />
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="dispatchDate" class="form-label fw-semibold text-dark small mb-1">Dispatch Date</label>
                        <input type="date" class="form-control form-control-sm bg-light" id="dispatchDate" name="DispatchDate" value="2026-11-07" />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="waybillNumber" class="form-label fw-semibold text-dark small mb-1">E-Waybill / Consignment #</label>
                        <input type="text" class="form-control form-control-sm bg-light font-monospace" id="waybillNumber" name="WaybillNumber" placeholder="WB-2948-102" value="WB-2948-102" />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="loadingDepot" class="form-label fw-semibold text-dark small mb-1">Origin Point</label>
                        <input type="text" class="form-control form-control-sm bg-light" id="loadingDepot" name="LoadingDepot" placeholder="Loading Depot" value="Okara Solvent Extraction Plant" />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="deliveryDestination" class="form-label fw-semibold text-dark small mb-1">Destination Point</label>
                        <input type="text" class="form-control form-control-sm bg-light" id="deliveryDestination" name="DeliveryDestination" placeholder="Destination Depot" value="Chiniot Feed Mill Silo" />
                    </div>

                </div>
            </div>
        </div>

        <!-- Split Columns: Seller Left vs Buyer Right -->
        <div class="row g-3 g-lg-4 mb-4">
            
            <!-- Seller Desk (Party A) -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-header bg-primary bg-opacity-10 border-bottom border-primary border-opacity-25 px-3 px-md-4 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary text-white p-2 rounded-circle">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </span>
                            <div>
                                <h6 class="fw-bold text-primary mb-0">Party A &bull; Dispatching Seller</h6>
                                <span class="text-secondary small">Origin Weighment &amp; Bill</span>
                            </div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Origin Books</span>
                    </div>

                    <div class="card-body p-3 p-md-4 bg-white">
                        <div class="mb-3 pb-3 border-bottom">
                            <label for="sellerName" class="form-label fw-semibold text-dark small mb-1">Seller Entity</label>
                            <input type="text" class="form-control form-control-sm bg-light" id="sellerName" name="SellerName" placeholder="Seller Name" value="Sabir Vegetable Oil (Okara)" required />
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label for="sellerContractWeight" class="form-label fw-semibold text-dark small mb-1">Contract Weight (MT)</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.001" class="form-control bg-light calc-input fw-bold" id="sellerContractWeight" name="SellerContractWeight" placeholder="0.000" value="48.500" required />
                                    <span class="input-group-text bg-light text-secondary">MT</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label for="sellerDispatchedWeight" class="form-label fw-semibold text-dark small mb-1">Dispatched Weight</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.001" class="form-control bg-light calc-input fw-bold text-primary" id="sellerDispatchedWeight" name="SellerDispatchedWeight" placeholder="0.000" value="48.250" required />
                                    <span class="input-group-text bg-light text-secondary">MT</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label for="sellerRate" class="form-label fw-semibold text-dark small mb-1">Agreed Rate (per MT)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="number" step="0.01" class="form-control bg-light calc-input fw-bold" id="sellerRate" name="SellerRate" placeholder="0.00" value="650.00" required />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label for="sellerGrossTotal" class="form-label fw-semibold text-dark small mb-1">Seller Gross Total</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="text" class="form-control bg-light fw-bold text-dark" id="sellerGrossTotal" readonly value="31,362.50" />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label for="sellerDeductions" class="form-label fw-semibold text-dark small mb-1">Deductions (Moisture/Dust)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="number" step="0.01" class="form-control bg-light calc-input" id="sellerDeductions" name="SellerDeductions" placeholder="0.00" value="120.00" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label for="sellerFreight" class="form-label fw-semibold text-dark small mb-1">Freight Committed</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="number" step="0.01" class="form-control bg-light calc-input" id="sellerFreight" name="SellerFreight" placeholder="0.00" value="1850.00" />
                                </div>
                            </div>
                        </div>

                        <div class="p-3 rounded-3 bg-light border border-secondary border-opacity-25 mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-secondary small fw-medium">Net Billable (Seller):</span>
                                <span class="fs-5 fw-bold text-primary" id="sellerNetTotalDisplay">PKR 31,242.50</span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Dispatched: <strong id="sellerWeightDisplay">48.250 MT</strong></span>
                                <span>Freight: <strong id="sellerFreightDisplay">PKR 1,850.00</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buyer Desk (Party B) -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-header bg-info bg-opacity-10 border-bottom border-info border-opacity-25 px-3 px-md-4 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-info text-dark p-2 rounded-circle">
                                <i class="bi bi-box-arrow-in-down-left"></i>
                            </span>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">Party B &bull; Receiving Buyer</h6>
                                <span class="text-secondary small">Destination Weighment</span>
                            </div>
                        </div>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Inward Books</span>
                    </div>

                    <div class="card-body p-3 p-md-4 bg-white">
                        <div class="mb-3 pb-3 border-bottom">
                            <label for="buyerName" class="form-label fw-semibold text-dark small mb-1">Buyer Entity</label>
                            <input type="text" class="form-control form-control-sm bg-light" id="buyerName" name="BuyerName" placeholder="Buyer Name" value="Faisal Feeds (Chiniot)" required />
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label for="buyerContractWeight" class="form-label fw-semibold text-dark small mb-1">Contract Weight (MT)</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.001" class="form-control bg-light calc-input fw-bold" id="buyerContractWeight" name="BuyerContractWeight" placeholder="0.000" value="48.500" required />
                                    <span class="input-group-text bg-light text-secondary">MT</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label for="buyerReceivedWeight" class="form-label fw-semibold text-dark small mb-1">Received Weight</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.001" class="form-control bg-light calc-input fw-bold text-info" id="buyerReceivedWeight" name="BuyerReceivedWeight" placeholder="0.000" value="48.050" required />
                                    <span class="input-group-text bg-light text-secondary">MT</span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label for="buyerRate" class="form-label fw-semibold text-dark small mb-1">Agreed Rate (per MT)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="number" step="0.01" class="form-control bg-light calc-input fw-bold" id="buyerRate" name="BuyerRate" placeholder="0.00" value="650.00" required />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label for="buyerGrossTotal" class="form-label fw-semibold text-dark small mb-1">Buyer Gross Recognized</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="text" class="form-control bg-light fw-bold text-dark" id="buyerGrossTotal" readonly value="31,232.50" />
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 g-md-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <label for="buyerDeductions" class="form-label fw-semibold text-dark small mb-1">Deductions (Shortage)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="number" step="0.01" class="form-control bg-light calc-input" id="buyerDeductions" name="BuyerDeductions" placeholder="0.00" value="130.00" />
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label for="buyerFreight" class="form-label fw-semibold text-dark small mb-1">Freight Allowed</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary">PKR</span>
                                    <input type="number" step="0.01" class="form-control bg-light calc-input" id="buyerFreight" name="BuyerFreight" placeholder="0.00" value="1850.00" />
                                </div>
                            </div>
                        </div>

                        <div class="p-3 rounded-3 bg-light border border-secondary border-opacity-25 mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-secondary small fw-medium">Net Payable (Buyer):</span>
                                <span class="fs-5 fw-bold text-dark" id="buyerNetTotalDisplay">PKR 31,102.50</span>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Accepted: <strong id="buyerWeightDisplay">48.050 MT</strong></span>
                                <span>Freight Cap: <strong id="buyerFreightDisplay">PKR 1,850.00</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Bilateral Variance & Live Delta Analysis -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" id="varianceCard">
            <div class="card-header bg-dark text-white px-3 px-md-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark rounded-circle p-1">
                        <i class="bi bi-exclamation-triangle"></i>
                    </span>
                    <span class="fw-bold small text-uppercase tracking-wider">Bilateral Variance &amp; Delta Inspection</span>
                </div>
                <div id="reconcileBadge">
                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold">
                        <i class="bi bi-clock-history me-1"></i> Variance Detected (-0.200 MT)
                    </span>
                </div>
            </div>

            <div class="card-body p-3 p-md-4 bg-light">
                <div class="row g-2 g-md-3 text-center">
                    
                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 bg-white rounded-3 border h-100 d-flex flex-column justify-content-center">
                            <span class="text-secondary small d-block mb-1">Weight Difference</span>
                            <div class="fs-6 fs-md-5 fw-bold text-dark" id="deltaWeight">-0.200 MT</div>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle small mt-1 align-self-center" id="deltaWeightPercent">0.41% Loss</span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 bg-white rounded-3 border h-100 d-flex flex-column justify-content-center">
                            <span class="text-secondary small d-block mb-1">Rate Alignment</span>
                            <div class="fs-6 fs-md-5 fw-bold text-success" id="deltaRate">PKR 0.00 / MT</div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle small mt-1 align-self-center">Rate Match</span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 bg-white rounded-3 border h-100 d-flex flex-column justify-content-center">
                            <span class="text-secondary small d-block mb-1">Freight Difference</span>
                            <div class="fs-6 fs-md-5 fw-bold text-success" id="deltaFreight">PKR 0.00</div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle small mt-1 align-self-center">Freight Matched</span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 bg-white rounded-3 border h-100 d-flex flex-column justify-content-center">
                            <span class="text-secondary small d-block mb-1">Net Settlement Break</span>
                            <div class="fs-6 fs-md-5 fw-bold text-danger" id="deltaSettlement">-PKR 140.00</div>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle small mt-1 align-self-center" id="deltaSettlementStatus">Buyer Deduction Break</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="card-footer bg-white p-3 border-top d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 small text-secondary text-center text-md-start">
                    <i class="bi bi-info-circle text-primary flex-shrink-0"></i>
                    <span>Submitting logs the bilateral trade record for automated Tally Desk verification.</span>
                </div>

                <div class="d-flex gap-2 w-100 w-md-auto justify-content-end">
                    <button type="reset" class="btn btn-outline-secondary px-3 py-2 rounded-pill small flex-grow-1 flex-md-grow-0">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </button>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm d-flex align-items-center justify-content-center gap-2 flex-grow-1 flex-md-grow-0">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                        <span>Commit Deal</span>
                    </button>
                </div>
            </div>
        </div>

    </form>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sellerWeightInput = document.getElementById('sellerDispatchedWeight');
            const sellerRateInput = document.getElementById('sellerRate');
            const sellerDeductionInput = document.getElementById('sellerDeductions');
            const sellerFreightInput = document.getElementById('sellerFreight');

            const buyerWeightInput = document.getElementById('buyerReceivedWeight');
            const buyerRateInput = document.getElementById('buyerRate');
            const buyerDeductionInput = document.getElementById('buyerDeductions');
            const buyerFreightInput = document.getElementById('buyerFreight');

            const sellerGrossTotal = document.getElementById('sellerGrossTotal');
            const buyerGrossTotal = document.getElementById('buyerGrossTotal');

            const sellerNetDisplay = document.getElementById('sellerNetTotalDisplay');
            const buyerNetDisplay = document.getElementById('buyerNetTotalDisplay');

            const sellerWeightDisplay = document.getElementById('sellerWeightDisplay');
            const buyerWeightDisplay = document.getElementById('buyerWeightDisplay');

            const deltaWeightEl = document.getElementById('deltaWeight');
            const deltaWeightPercentEl = document.getElementById('deltaWeightPercent');
            const deltaRateEl = document.getElementById('deltaRate');
            const deltaFreightEl = document.getElementById('deltaFreight');
            const deltaSettlementEl = document.getElementById('deltaSettlement');
            const deltaSettlementStatus = document.getElementById('deltaSettlementStatus');
            const reconcileBadge = document.getElementById('reconcileBadge');

            function calculateTotals() {
                const sWeight = parseFloat(sellerWeightInput.value) || 0;
                const sRate = parseFloat(sellerRateInput.value) || 0;
                const sDeduct = parseFloat(sellerDeductionInput.value) || 0;
                const sFreight = parseFloat(sellerFreightInput.value) || 0;

                const bWeight = parseFloat(buyerWeightInput.value) || 0;
                const bRate = parseFloat(buyerRateInput.value) || 0;
                const bDeduct = parseFloat(buyerDeductionInput.value) || 0;
                const bFreight = parseFloat(buyerFreightInput.value) || 0;

                const sGross = sWeight * sRate;
                const bGross = bWeight * bRate;

                const sNet = sGross - sDeduct;
                const bNet = bGross - bDeduct;

                sellerGrossTotal.value = sGross.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                buyerGrossTotal.value = bGross.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                sellerNetDisplay.textContent = 'PKR ' + sNet.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                buyerNetDisplay.textContent = 'PKR ' + bNet.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                sellerWeightDisplay.textContent = sWeight.toFixed(3) + ' MT';
                buyerWeightDisplay.textContent = bWeight.toFixed(3) + ' MT';

                // Variances
                const wDiff = bWeight - sWeight;
                const rDiff = bRate - sRate;
                const fDiff = bFreight - sFreight;
                const netDiff = bNet - sNet;

                // Weight delta
                if (Math.abs(wDiff) < 0.001) {
                    deltaWeightEl.textContent = '0.000 MT';
                    deltaWeightEl.className = 'fs-6 fs-md-5 fw-bold text-success';
                    deltaWeightPercentEl.textContent = 'Exact Match';
                    deltaWeightPercentEl.className = 'badge bg-success-subtle text-success border border-success-subtle small mt-1 align-self-center';
                } else {
                    deltaWeightEl.textContent = (wDiff > 0 ? '+' : '') + wDiff.toFixed(3) + ' MT';
                    deltaWeightEl.className = 'fs-6 fs-md-5 fw-bold ' + (Math.abs(wDiff) > 0.3 ? 'text-danger' : 'text-warning');
                    const pct = ((Math.abs(wDiff) / (sWeight || 1)) * 100).toFixed(2);
                    deltaWeightPercentEl.textContent = pct + '% Transit ' + (wDiff < 0 ? 'Loss' : 'Gain');
                    deltaWeightPercentEl.className = 'badge bg-warning-subtle text-warning border border-warning-subtle small mt-1 align-self-center';
                }

                // Rate delta
                if (Math.abs(rDiff) < 0.01) {
                    deltaRateEl.textContent = 'PKR 0.00 / MT';
                    deltaRateEl.className = 'fs-6 fs-md-5 fw-bold text-success';
                } else {
                    deltaRateEl.textContent = (rDiff > 0 ? '+PKR ' : '-PKR ') + Math.abs(rDiff).toFixed(2) + ' / MT';
                    deltaRateEl.className = 'fs-6 fs-md-5 fw-bold text-danger';
                }

                // Freight delta
                if (Math.abs(fDiff) < 0.01) {
                    deltaFreightEl.textContent = 'PKR 0.00';
                    deltaFreightEl.className = 'fs-6 fs-md-5 fw-bold text-success';
                } else {
                    deltaFreightEl.textContent = (fDiff > 0 ? '+PKR ' : '-PKR ') + Math.abs(fDiff).toFixed(2);
                    deltaFreightEl.className = 'fs-6 fs-md-5 fw-bold text-warning';
                }

                // Settlement delta
                if (Math.abs(netDiff) < 0.01) {
                    deltaSettlementEl.textContent = 'PKR 0.00';
                    deltaSettlementEl.className = 'fs-6 fs-md-5 fw-bold text-success';
                    deltaSettlementStatus.textContent = 'Balanced Books';
                    deltaSettlementStatus.className = 'badge bg-success-subtle text-success border border-success-subtle small mt-1 align-self-center';
                    reconcileBadge.innerHTML = '<span class="badge bg-success text-white px-3 py-1 rounded-pill fw-semibold"><i class="bi bi-check-circle me-1"></i> Books In Balance</span>';
                } else {
                    deltaSettlementEl.textContent = (netDiff > 0 ? '+PKR ' : '-PKR ') + Math.abs(netDiff).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    deltaSettlementEl.className = 'fs-6 fs-md-5 fw-bold text-danger';
                    deltaSettlementStatus.textContent = netDiff < 0 ? 'Buyer Shortage Variance' : 'Buyer Over-Allowance';
                    deltaSettlementStatus.className = 'badge bg-danger-subtle text-danger border border-danger-subtle small mt-1 align-self-center';
                    reconcileBadge.innerHTML = '<span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold"><i class="bi bi-exclamation-triangle me-1"></i> Variance (' + wDiff.toFixed(3) + ' MT)</span>';
                }
            }

            document.querySelectorAll('.calc-input').forEach(function (inp) {
                inp.addEventListener('input', calculateTotals);
            });

            const demoBtn = document.getElementById('btnFillDemoDeal');
            if (demoBtn) {
                demoBtn.addEventListener('click', function () {
                    document.getElementById('doNumber').value = 'DO-2026-99120';
                    document.getElementById('truckNumber').value = 'TKP-841 (Multan)';
                    document.getElementById('transporter').value = 'Malik Goods Transport Agency';
                    document.getElementById('itemCommodity').value = 'Soyabean Seed Meal (Hi-Pro)';
                    sellerWeightInput.value = '52.400';
                    sellerRateInput.value = '710.00';
                    sellerDeductionInput.value = '80.00';
                    sellerFreightInput.value = '2100.00';

                    buyerWeightInput.value = '52.400';
                    buyerRateInput.value = '710.00';
                    buyerDeductionInput.value = '80.00';
                    buyerFreightInput.value = '2100.00';

                    calculateTotals();
                });
            }

            calculateTotals();
        });
    </script>
}