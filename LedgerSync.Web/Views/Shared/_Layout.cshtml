<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LedgerSync Enterprise Trade Settlement</title>
    <!-- Bootstrap 5.3 CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LedgerSync.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Modern Dark Top Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2 shadow-sm sticky-top">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold tracking-wide text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="navbar-brand-badge">
                        <i class="bi bi-intersect"></i>
                    </span>
                    <span>Ledger<span class="text-info">Sync</span></span>
                    <span class="badge bg-secondary-subtle text-info border border-info-subtle rounded-pill fs-7 px-2 py-0 ms-1 d-none d-md-inline-block">Enterprise</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none text-light" type="button" data-bs-toggle="collapse" data-bs-target="#ledgerNavbarContent"
                        aria-controls="ledgerNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="ledgerNavbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i>
                                <span>Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Deals" asp-action="Create">
                                <i class="bi bi-file-earmark-diff"></i>
                                <span>Deal Desk</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Reconciliation" asp-action="Index">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Tally Desk</span>
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mt-2 mt-lg-0">
                        <div class="d-none d-xl-flex align-items-center me-2 text-secondary small">
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-circle p-1 me-2"></span>
                            <span>Bilateral Ledger Active</span>
                        </div>

                        <a class="btn btn-outline-light btn-sm px-3 rounded-pill d-flex align-items-center justify-content-center gap-2 fw-medium" asp-area="" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Sign In</span>
                        </a>

                        <a class="btn btn-info btn-sm text-dark px-3 rounded-pill d-flex align-items-center justify-content-center gap-2 fw-semibold shadow-sm" asp-area="" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-building-add"></i>
                            <span>Register Tenant</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Modern Dark Footer -->
    <footer class="footer-custom py-5 mt-auto">
        <div class="container-fluid px-lg-5">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="navbar-brand-badge">
                            <i class="bi bi-intersect"></i>
                        </span>
                        <span class="h5 mb-0 fw-bold text-white">Ledger<span class="text-info">Sync</span></span>
                    </div>
                    <p class="text-secondary small mb-3 leading-relaxed">
                        Next-generation dual-party trade settlement and continuous ledger reconciliation engine. Eliminating discrepancy breaks across bilateral trade books with instant cryptographic consensus.
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-dark border border-secondary text-light small px-2 py-1">
                            <i class="bi bi-shield-lock-fill text-info me-1"></i> SOC2 Type II Certified
                        </span>
                        <span class="badge bg-dark border border-secondary text-light small px-2 py-1">
                            <i class="bi bi-patch-check-fill text-success me-1"></i> ISO 27001
                        </span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-white fw-semibold mb-3">Operations</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li>
                            <a class="footer-link d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-chevron-right text-secondary small"></i> Platform Overview
                            </a>
                        </li>
                        <li>
                            <a class="footer-link d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Deals" asp-action="Create">
                                <i class="bi bi-chevron-right text-secondary small"></i> Deal Desk Intake
                            </a>
                        </li>
                        <li>
                            <a class="footer-link d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Reconciliation" asp-action="Index">
                                <i class="bi bi-chevron-right text-secondary small"></i> Tally Desk Matcher
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-white fw-semibold mb-3">Tenant & Access</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li>
                            <a class="footer-link d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-chevron-right text-secondary small"></i> Institutional Sign In
                            </a>
                        </li>
                        <li>
                            <a class="footer-link d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-chevron-right text-secondary small"></i> Register Organization
                            </a>
                        </li>
                        <li>
                            <a class="footer-link d-inline-flex align-items-center gap-1" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-chevron-right text-secondary small"></i> Security & Privacy
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="text-white fw-semibold mb-3">Real-Time Operational Pulse</h6>
                    <div class="p-3 rounded-3 bg-black border border-secondary border-opacity-25">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-secondary">Matching Engine State</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                <i class="bi bi-record-fill me-1"></i> 99.999% Nominal
                            </span>
                        </div>
                        <div class="progress bg-dark" style="height: 6px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between text-secondary mt-2 ls-code-badge">
                            <span>Latency: 1.8ms</span>
                            <span>Bilateral Attestation: Synced</span>
                        </div>
                    </div>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-secondary">
                <div>
                    &copy; @DateTime.UtcNow.Year LedgerSync Technologies Inc. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy Policy</a>
                    <span class="text-secondary opacity-50">&bull;</span>
                    <a href="#terms" class="footer-link">Terms of Service</a>
                    <span class="text-secondary opacity-50">&bull;</span>
                    <a href="#compliance" class="footer-link">Compliance & Audits</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 Bundle JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
