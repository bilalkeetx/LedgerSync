<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@ViewData["Title"] - LedgerSync</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        body { 
            background-color: #f8fafc; 
        }
        .auth-container { 
            width: 100%; 
            max-width: 520px; 
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 justify-content-center py-4 py-md-5">

    <main class="container d-flex justify-content-center align-items-center">
        <div class="auth-container px-2 px-sm-3">
            
            <!-- Branding Header -->
            <div class="text-center mb-4">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark d-inline-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white p-2 rounded-circle">
                        <i class="bi bi-intersect fs-5"></i>
                    </span>
                    <span class="fs-4 fw-bold tracking-tight">LedgerSync</span>
                </a>
                <p class="text-secondary small mt-1 mb-0">Bilateral Commodity Settlement &amp; Tally Desk</p>
            </div>

            <!-- Card Container -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-sm-4 p-md-4">
                @RenderBody()
            </div>

            <!-- Global Footer Note -->
            <div class="text-center mt-4 text-muted small" style="font-size: 0.8rem;">
                &copy; 2026 LedgerSync Systems &bull; Institutional Multi-Party Ledger
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>