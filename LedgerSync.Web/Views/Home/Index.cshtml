@{
    ViewData["Title"] = "Dual-Party Trade Settlement & Ledger Sync";
}

<!-- Hero Banner -->
<section class="position-relative overflow-hidden text-white py-4 py-md-5" style="background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0b0f19 85%);">
    <div class="container px-3 px-md-4 py-3 position-relative">
        <div class="row align-items-center gy-4">
            <div class="col-12 col-lg-7">
                <div class="mb-3">
                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fw-semibold small">
                        <i class="bi bi-shield-check me-1"></i> Multi-Party Commodity Ledger
                    </span>
                </div>
                
                <h1 class="display-6 display-md-5 fw-bold tracking-tight text-white mb-3">
                    Bilateral Trade Settlement &amp; Continuous Ledger Sync
                </h1>
                
                <p class="text-secondary mb-4 fs-6 pe-lg-3" style="line-height: 1.6;">
                    Enable counterparty desks with simultaneous deal verification, automated bilateral confirmation, and real-time reconciliation tallying. Eliminate post-trade breaks before clearing.
                </p>

                <!-- Actions -->
                <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center mb-4">
                    <a class="btn btn-info text-dark fw-semibold px-4 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2" asp-controller="Deals" asp-action="Create">
                        <i class="bi bi-file-earmark-plus"></i>
                        <span>Enter Deal Desk</span>
                    </a>
                    <a class="btn btn-outline-light fw-medium px-4 py-2 rounded-pill d-flex align-items-center gap-2" asp-controller="Reconciliation" asp-action="Index">
                        <i class="bi bi-arrow-left-right text-info"></i>
                        <span>Open Tally Desk</span>
                    </a>
                    <a class="btn btn-link text-secondary text-decoration-none d-flex align-items-center gap-1 px-2" asp-controller="Account" asp-action="Register">
                        <span>Register Tenant</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <!-- Metrics Strip -->
                <div class="row g-2 g-sm-3 pt-3 border-top border-secondary border-opacity-25 text-center text-sm-start">
                    <div class="col-4 col-sm-3">
                        <div class="fw-bold text-white fs-6 fs-sm-5 mb-0">PKR 450M+</div>
                        <div class="text-secondary small" style="font-size: 0.75rem;">Monthly Volume</div>
                    </div>
                    <div class="col-4 col-sm-3">
                        <div class="fw-bold text-info fs-6 fs-sm-5 mb-0">Autonomous</div>
                        <div class="text-secondary small" style="font-size: 0.75rem;">Auto-Tally</div>
                    </div>
                    <div class="col-4 col-sm-3">
                        <div class="fw-bold text-success fs-6 fs-sm-5 mb-0">Zero Breaks</div>
                        <div class="text-secondary small" style="font-size: 0.75rem;">Bilateral Sync</div>
                    </div>
                </div>
            </div>

            <!-- Hero Live Status Card -->
            <div class="col-12 col-lg-5">
                <div class="card bg-dark border-secondary border-opacity-50 shadow rounded-4 overflow-hidden">
                    <div class="card-header bg-black bg-opacity-40 border-bottom border-secondary border-opacity-25 px-3 px-md-4 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-circle p-1"></span>
                            <span class="small fw-semibold text-light text-truncate">Chowk Shah Abbas Desk</span>
                        </div>
                        <span class="badge bg-secondary-subtle text-light font-monospace small">BATCH #1849203</span>
                    </div>
                    
                    <div class="card-body p-3 p-md-4 text-light">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-secondary small">Bilateral Handshake</span>
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Synchronized</span>
                        </div>

                        <!-- Mini Trade Pipeline -->
