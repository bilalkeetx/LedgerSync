                                    <i class="bi bi-building text-info flex-shrink-0"></i>
                                    <span class="text-truncate">Party A: Sabir Vegetable Oil</span>
                                </div>
                                <span class="badge bg-success text-white flex-shrink-0"><i class="bi bi-check2"></i> Signed</span>
                            </div>

                            <div class="text-center text-secondary small py-0 my-0">
                                <i class="bi bi-arrow-down-up text-info"></i> Invariant Match
                            </div>

                            <div class="p-2 rounded bg-black bg-opacity-50 border border-secondary border-opacity-25 d-flex justify-content-between align-items-center small">
                                <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                    <i class="bi bi-globe2 text-warning flex-shrink-0"></i>
                                    <span class="text-truncate">Party B: Faisal Feeds</span>
                                </div>
                                <span class="badge bg-success text-white flex-shrink-0"><i class="bi bi-check2"></i> Signed</span>
                            </div>
                        </div>

                        <div class="p-3 rounded-3 bg-black border border-secondary border-opacity-25 small text-secondary">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span>Double-Entry Proof</span>
                                <span class="text-success fw-semibold"><i class="bi bi-shield-fill-check"></i> PASS (0 Deltas)</span>
                            </div>
                            <div class="d-flex justify-content-between font-monospace text-muted small" style="font-size: 0.75rem;">
                                <span>REF: VR-88419-OKR</span>
                                <span>TALLY: BALANCED</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Interactive Trade Settlement Explorer -->
