@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const verifyBtn = document.getElementById('btnRunVerification');
            const verifyIcon = document.getElementById('verificationIcon');
            const verifyStatus = document.getElementById('verificationStatus');
            const verifyDetails = document.getElementById('verificationDetails');

            if (verifyBtn) {
                verifyBtn.addEventListener('click', function () {
                    verifyIcon.classList.add('spinner-border', 'spinner-border-sm');
                    verifyIcon.classList.remove('bi-arrow-repeat');
                    verifyStatus.textContent = 'Verifying Vouchers...';
                    verifyBtn.disabled = true;

                    setTimeout(function () {
                        verifyIcon.classList.remove('spinner-border', 'spinner-border-sm');
                        verifyIcon.classList.add('bi-check-circle-fill', 'text-success');
                        verifyStatus.textContent = 'Matched (0 Deltas)';
                        verifyDetails.innerHTML = '<span class="badge bg-success text-white">Reconciled &bull; 0 Deltas</span>';
                        verifyBtn.classList.remove('btn-outline-dark');
                        verifyBtn.classList.add('btn-outline-success');

                        setTimeout(function () {
                            verifyBtn.disabled = false;
                            verifyIcon.classList.remove('bi-check-circle-fill', 'text-success');
                            verifyIcon.classList.add('bi-arrow-repeat');
                            verifyStatus.textContent = 'Re-Run Verification';
                            verifyBtn.classList.remove('btn-outline-success');
                            verifyBtn.classList.add('btn-outline-dark');
                        }, 3500);
                    }, 800);
                });
            }
        });
    </script>
}
