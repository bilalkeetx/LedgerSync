@{
    ViewData["Title"] = "Tally Reconciliation Desk";
}

<div class="container-fluid px-2 px-md-3 px-lg-4 py-3 py-md-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tally Desk</li>
                </ol>
            </nav>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="h3 fw-bold text-dark mb-0">Discrepancy Matcher &amp; Ledger Tally</h1>
                <span class="badge bg-secondary-subtle text-dark border rounded-pill">Continuous Sync</span>
            </div>
            <p class="text-secondary small mb-0 mt-1">Reconciliation between Seller Delivery Orders and Buyer Inward Goods.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
            <a asp-controller="Deals" asp-action="Create" class="btn btn-outline-dark btn-sm px-3 py-2 rounded-pill fw-medium flex-grow-1 flex-md-grow-0 d-flex align-items-center justify-content-center gap-1">
                <i class="bi bi-plus-circle"></i>
                <span>Capture Deal</span>
            </a>
            <button type="button" class="btn btn-dark btn-sm px-3 py-2 rounded-pill fw-medium flex-grow-1 flex-md-grow-0 d-flex align-items-center justify-content-center gap-1">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <span>Export Report</span>
            </button>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 p-md-4 border-0 shadow-sm rounded-4 bg-white">
                <div class="text-secondary small fw-semibold text-uppercase tracking-wider mb-1" style="font-size: 0.75rem;">Ingested Invoices</div>
                <div class="fs-4 fs-md-3 fw-bold text-dark mb-1">148 Records</div>
                <div class="text-muted small" style="font-size: 0.78rem;">Across 42 D.O. Batches</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 p-md-4 border-0 shadow-sm rounded-4 bg-white border-start border-success border-4">
                <div class="text-success small fw-semibold text-uppercase tracking-wider mb-1" style="font-size: 0.75rem;">Matched &amp; Balanced</div>
                <div class="fs-4 fs-md-3 fw-bold text-success mb-1">132 (89.2%)</div>
                <div class="text-muted small" style="font-size: 0.78rem;">Zero Discrepancy</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 p-md-4 border-0 shadow-sm rounded-4 bg-white border-start border-warning border-4">
                <div class="text-warning-emphasis small fw-semibold text-uppercase tracking-wider mb-1" style="font-size: 0.75rem;">Variances Detected</div>
                <div class="fs-4 fs-md-3 fw-bold text-warning-emphasis mb-1">11 (7.4%)</div>
                <div class="text-muted small" style="font-size: 0.78rem;">Transit &amp; Rate Breaks</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 p-md-4 border-0 shadow-sm rounded-4 bg-white border-start border-danger border-4">
                <div class="text-danger small fw-semibold text-uppercase tracking-wider mb-1" style="font-size: 0.75rem;">Missing Inward</div>
                <div class="fs-4 fs-md-3 fw-bold text-danger mb-1">5 (3.4%)</div>
                <div class="text-muted small" style="font-size: 0.78rem;">Unacknowledged Bills</div>
            </div>
        </div>
    </div>

    <!-- Ledger Table Matrix -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="p-3 p-md-4 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">Bilateral Variance Matrix</h5>
                <p class="text-secondary small mb-0">Comparing Seller Dispatch Weights against Destination Weighbridge Receipts.</p>
            </div>
            
            <!-- Filter Pills (Scrollable on Mobile) -->
            <div class="overflow-x-auto w-100 w-md-auto pb-1 pb-md-0">
                <div class="d-flex gap-2 flex-nowrap">
                    <button type="button" class="btn btn-sm btn-dark px-3 rounded-pill text-nowrap">All (148)</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 rounded-pill text-nowrap">Matched (132)</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 rounded-pill text-nowrap">Variances (11)</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 rounded-pill text-nowrap">Missing (5)</button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                    <tr>
                        <th class="ps-3 ps-md-4 py-3 text-nowrap">Identifiers</th>
                        <th class="py-3 text-nowrap">Party A (Seller)</th>
                        <th class="py-3 text-nowrap">Party B (Buyer)</th>
                        <th class="py-3 text-nowrap">Variance Analysis</th>
                        <th class="py-3 text-nowrap">Status</th>
                        <th class="text-end pe-3 pe-md-4 py-3 text-nowrap">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1: Balanced -->
                    <tr>
                        <td class="ps-3 ps-md-4 py-3">
                            <div class="fw-bold text-dark font-monospace">DO-2026-88401</div>
                            <div class="text-secondary small">LHR-TK-1049 &bull; Soya Meal</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-nowrap">48.200 MT (964 Bags)</div>
                            <div class="text-secondary small text-nowrap">PKR 162.00 &bull; Net: PKR 7,808,400</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-nowrap">48.200 MT (964 Bags)</div>
                            <div class="text-secondary small text-nowrap">PKR 162.00 &bull; Net: PKR 7,808,400</div>
                        </td>
                        <td>
                            <span class="text-success small fw-semibold text-nowrap"><i class="bi bi-check2"></i> 0.000 MT Delta</span>
                            <div class="text-muted small">Variance: Balanced</div>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Matched</span>
                        </td>
                        <td class="text-end pe-3 pe-md-4">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Attested</button>
                        </td>
                    </tr>

                    <!-- Row 2: Weight Variance -->
                    <tr>
                        <td class="ps-3 ps-md-4 py-3">
                            <div class="fw-bold text-dark font-monospace">DO-2026-88402</div>
                            <div class="text-secondary small">FSD-TK-7714 &bull; Canola Meal</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-nowrap">52.400 MT (1,048 Bags)</div>
                            <div class="text-secondary small text-nowrap">PKR 115.00 &bull; Net: PKR 6,026,000</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-nowrap">51.900 MT (1,038 Bags)</div>
                            <div class="text-secondary small text-nowrap">PKR 115.00 &bull; Net: PKR 5,968,500</div>
                        </td>
                        <td>
                            <span class="text-danger small fw-semibold text-nowrap"><i class="bi bi-dash-circle"></i> -0.500 MT (-0.95%)</span>
                            <div class="text-muted small text-nowrap">Delta: -PKR 57,500</div>
                        </td>
                        <td>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Variance</span>
                        </td>
                        <td class="text-end pe-3 pe-md-4">
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3">Arbitrate</button>
                        </td>
                    </tr>

                    <!-- Row 3: Missing Inward Record -->
                    <tr>
                        <td class="ps-3 ps-md-4 py-3">
                            <div class="fw-bold text-dark font-monospace">DO-2026-88404</div>
                            <div class="text-secondary small">OK-TK-9021 &bull; Yellow Corn</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-nowrap">39.800 MT (796 Bags)</div>
                            <div class="text-secondary small text-nowrap">PKR 72.00 &bull; Net: PKR 2,865,600</div>
                        </td>
                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 text-nowrap">
                                <i class="bi bi-exclamation-triangle"></i> Not in Buyer Books
                            </span>
                        </td>
                        <td>
                            <span class="text-danger small fw-semibold text-nowrap"><i class="bi bi-x-circle"></i> Ledger Break</span>
                            <div class="text-muted small text-nowrap">Break: PKR 2,865,600</div>
                        </td>
                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Missing</span>
                        </td>
                        <td class="text-end pe-3 pe-md-4">
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3">Issue Claim</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>