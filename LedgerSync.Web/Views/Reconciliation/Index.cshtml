@{
    ViewData["Title"] = "Tally Reconciliation Desk";
}

<div class="container-xl py-5">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2" data-aos="fade-up">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tally Desk</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0">Discrepancy Matcher & Ledger Tally</h3>
            <p class="text-muted small mt-1">Side-by-side reconciliation between Seller Delivery Orders and Buyer Inward Goods</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-controller="Deals" asp-action="Create" class="btn btn-outline-dark px-3 py-2 rounded-2 small fw-medium">
                <i class="bi bi-plus-circle me-1"></i> Capture Deal
            </a>
            <button class="btn btn-dark px-3 py-2 rounded-2 small fw-medium">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Tally Report
            </button>
        </div>
    </div>

    <!-- KPI Summary Row with Adequate Breathing Space -->
    <div class="row g-4 mb-5" data-aos="fade-up" data-aos-delay="100">
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 p-4 border bg-white shadow-none">
                <div class="text-muted small fw-semibold text-uppercase tracking-wide mb-2">Ingested Invoices</div>
                <div class="fs-2 fw-bold text-dark mb-1">148 Records</div>
                <div class="text-muted small">Across 42 Delivery Orders</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 p-4 border border-success-subtle bg-white shadow-none">
                <div class="text-success small fw-semibold text-uppercase tracking-wide mb-2">Matched & Balanced</div>
                <div class="fs-2 fw-bold text-success mb-1">132 (89.2%)</div>
                <div class="text-muted small">Zero Discrepancy Verified</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 p-4 border border-warning-subtle bg-white shadow-none">
                <div class="text-warning-emphasis small fw-semibold text-uppercase tracking-wide mb-2">Weight / Rate Variances</div>
                <div class="fs-2 fw-bold text-warning-emphasis mb-1">11 (7.4%)</div>
                <div class="text-muted small">Transit Shortage & Rate Deltas</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 p-4 border border-danger-subtle bg-white shadow-none">
                <div class="text-danger small fw-semibold text-uppercase tracking-wide mb-2">Missing Inward Books</div>
                <div class="fs-2 fw-bold text-danger mb-1">5 (3.4%)</div>
                <div class="text-muted small">Unacknowledged Dispatch Bills</div>
            </div>
        </div>
    </div>

    <!-- Ledger Table Matrix -->
    <div class="card border bg-white shadow-sm overflow-hidden" data-aos="fade-up" data-aos-delay="200">
        <div class="p-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white">
            <div>
                <h5 class="fw-bold mb-1 text-dark">Bilateral Transaction Variance Matrix</h5>
                <p class="text-muted small mb-0">Comparing Seller Dispatch Weights against Buyer Destination Dharam Kanta receipts</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-dark px-3 rounded-2">All (148)</button>
                <button class="btn btn-sm btn-outline-secondary px-3 rounded-2">Matched (132)</button>
                <button class="btn btn-sm btn-outline-secondary px-3 rounded-2">Variances (11)</button>
                <button class="btn btn-sm btn-outline-secondary px-3 rounded-2">Missing (5)</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                <thead class="table-light text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                    <tr>
                        <th class="ps-4 py-3">Identifiers</th>
                        <th class="py-3">Party A (Seller Dispatched)</th>
                        <th class="py-3">Party B (Buyer Received)</th>
                        <th class="py-3">Variance Analysis</th>
                        <th class="py-3">Status</th>
                        <th class="text-end pe-4 py-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1: Balanced -->
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="fw-bold text-dark">DO-2026-88401</div>
                            <div class="text-muted small">LHR-TK-1049 &bull; Soyabean Meal</div>
                        </td>
                        <td>
                            <div class="fw-medium">48.200 MT (964 Bags)</div>
                            <div class="text-muted small">PKR 162.00 / Kg &bull; Net: PKR 7,808,400</div>
                        </td>
                        <td>
                            <div class="fw-medium">48.200 MT (964 Bags)</div>
                            <div class="text-muted small">PKR 162.00 / Kg &bull; Net: PKR 7,808,400</div>
                        </td>
                        <td>
                            <span class="text-success small fw-medium"><i class="bi bi-check2"></i> 0.000 MT Delta</span>
                            <div class="text-muted small">Variance: Balanced</div>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Matched</span>
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-secondary rounded-2">Attested</button>
                        </td>
                    </tr>

                    <!-- Row 2: Weight Variance -->
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="fw-bold text-dark">DO-2026-88402</div>
                            <div class="text-muted small">FSD-TK-7714 &bull; Canola Meal</div>
                        </td>
                        <td>
                            <div class="fw-medium">52.400 MT (1,048 Bags)</div>
                            <div class="text-muted small">PKR 115.00 / Kg &bull; Net: PKR 6,026,000</div>
                        </td>
                        <td>
                            <div class="fw-medium">51.900 MT (1,038 Bags)</div>
                            <div class="text-muted small">PKR 115.00 / Kg &bull; Net: PKR 5,968,500</div>
                        </td>
                        <td>
                            <span class="text-danger small fw-semibold"><i class="bi bi-dash-circle"></i> -0.500 MT (-0.95%)</span>
                            <div class="text-muted small">Settlement Delta: -PKR 57,500</div>
                        </td>
                        <td>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Weight Variance</span>
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-dark rounded-2">Arbitrate</button>
                        </td>
                    </tr>

                    <!-- Row 3: Missing Inward Record -->
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="fw-bold text-dark">DO-2026-88404</div>
                            <div class="text-muted small">OK-TK-9021 &bull; Yellow Corn / Maize</div>
                        </td>
                        <td>
                            <div class="fw-medium">39.800 MT (796 Bags)</div>
                            <div class="text-muted small">PKR 72.00 / Kg &bull; Net: PKR 2,865,600</div>
                        </td>
                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                <i class="bi bi-exclamation-triangle"></i> Not in Buyer Inward Book
                            </span>
                        </td>
                        <td>
                            <span class="text-danger small fw-semibold"><i class="bi bi-x-circle"></i> Full Ledger Break</span>
                            <div class="text-muted small">Discrepancy: PKR 2,865,600</div>
                        </td>
                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Missing Record</span>
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-danger rounded-2">Issue Claim</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>