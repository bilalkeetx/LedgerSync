                    </td>
                </tr>

                <!-- Row 2: Weight Variance -->
                <tr>
                    <td class="ps-3">
                        <div class="fw-semibold text-dark">DO-2026-88402</div>
                        <div class="text-muted small">FSD-TK-7714 &bull; Canola Meal</div>
                    </td>
                    <td>
                        <div>52.400 MT (1,048 Bags)</div>
                        <div class="text-muted small">PKR 115.00 / Kg &bull; Freight: PKR 84,000 | Net: PKR 6,026,000</div>
                    </td>
                    <td>
