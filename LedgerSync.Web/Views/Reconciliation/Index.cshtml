                    <tr>
                        <th class="ps-4">Identifiers</th>
                        <th>Party A &bull; Seller Dispatched</th>
                        <th>Party B &bull; Buyer Received</th>
                        <th>Variance Analysis</th>
                        <th>Status</th>
