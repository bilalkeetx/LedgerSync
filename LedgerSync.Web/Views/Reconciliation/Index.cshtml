                    <span class="badge bg-danger rounded-circle p-1"></span> Missing Records (Red)
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span>Showing <strong id="visibleRowCount">7</strong> representative sample records</span>
                <a class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1" asp-controller="Deals" asp-action="Create">
                    <i class="bi bi-plus-circle me-1"></i> New Trade Deal
                </a>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Drag and Drop Ingestion Zone Interactive Handlers
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('statementFileInput');
            const dropZoneTitle = document.getElementById('dropZoneTitle');
            const dropZoneSubtitle = document.getElementById('dropZoneSubtitle');

            if (dropZone && fileInput) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    dropZone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZone.style.borderColor = '#2563eb';
                        dropZone.style.backgroundColor = '#eff6ff';
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropZone.addEventListener(eventName, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        dropZone.style.borderColor = '#94a3b8';
                        dropZone.style.backgroundColor = '#f8fafc';
                    }, false);
                });

                dropZone.addEventListener('drop', function (e) {
                    const dt = e.dataTransfer;
                    const files = dt.files;
                    if (files.length > 0) {
                        handleFileSelection(files[0].name);
                    }
                });

                fileInput.addEventListener('change', function () {
                    if (fileInput.files.length > 0) {
                        handleFileSelection(fileInput.files[0].name);
                    }
                });
            }

            function handleFileSelection(fileName) {
                if (dropZoneTitle && dropZoneSubtitle) {
                    dropZoneTitle.innerHTML = '<span class="text-success"><i class="bi bi-file-earmark-check-fill me-1"></i> ' + fileName + '</span>';
                    dropZoneSubtitle.textContent = 'Statement successfully staged for bilateral invariant matching. Click "Run Invariant Engine" to execute.';
                    dropZone.style.borderColor = '#10b981';
                    dropZone.style.backgroundColor = '#ecfdf5';
                }
            }

            // Interactive Table Filter Pills
            const filterButtons = document.querySelectorAll('.filter-btn');
            const rows = document.querySelectorAll('.discrepancy-row');
            const visibleCountEl = document.getElementById('visibleRowCount');

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterButtons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const filter = this.getAttribute('data-filter');
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const rowStatus = row.getAttribute('data-status');
                        if (filter === 'all' || rowStatus === filter) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    if (visibleCountEl) {
                        visibleCountEl.textContent = visibleCount;
                    }
                });
            });

            // Search Table Input Filter
            const searchInput = document.getElementById('searchTableInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        if (text.includes(query)) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    if (visibleCountEl) {
                        visibleCountEl.textContent = visibleCount;
                    }
                });
            }

            // Simulate Sample Reload Button
            const btnSimulate = document.getElementById('btnSimulateSample');
            if (btnSimulate) {
                btnSimulate.addEventListener('click', function () {
                    btnSimulate.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Ingesting...';
                    setTimeout(() => {
                        btnSimulate.innerHTML = '<i class="bi bi-check-circle-fill text-success me-1"></i> Data Refreshed';
                        handleFileSelection('Sabir_vs_Faisal_Bilateral_Nov2026.xlsx');
                        setTimeout(() => {
                            btnSimulate.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Reload Bilateral Batch Data';
                        }, 2500);
                    }, 600);
                });
            }

            // Export Sheet Alert
            const btnExport = document.getElementById('btnExportBreaks');
            if (btnExport) {
                btnExport.addEventListener('click', function () {
                    btnExport.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Generating CSV...';
                    setTimeout(() => {
                        btnExport.innerHTML = '<i class="bi bi-download me-1"></i> Export Break Sheet';
                        alert('Bilateral Discrepancy Break Sheet exported successfully (11 Variances, 5 Missing Records).');
                    }, 600);
                });
            }
        });
    </script>
}
