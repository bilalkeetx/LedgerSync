@{
    ViewData["Title"] = "Tally Desk - Bilateral Statement Reconciliation";
}

<div class="container-fluid px-lg-4 py-4">

    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tally Desk</li>
                    <li class="breadcrumb-item active" aria-current="page">Statement Reconciliation</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <span>Tally Desk Statement Ingestion &amp; Discrepancy Matcher</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle fs-7 rounded-pill">Continuous Sync Engine</span>
            </h2>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary btn-sm px-3 rounded-pill d-flex align-items-center gap-1" asp-controller="Deals" asp-action="Create">
                <i class="bi bi-plus-circle"></i>
                <span>Capture New Deal</span>
            </a>
            <button type="button" class="btn btn-dark btn-sm px-3 rounded-pill d-flex align-items-center gap-1" id="btnExportBreaks">
                <i class="bi bi-download"></i>
                <span>Export Break Sheet</span>
            </button>
        </div>
    </div>

    <!-- KPI Summary Metrics Strip -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 ls-card">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-secondary small fw-semibold text-uppercase">Ingested Records</span>
                    <span class="badge bg-secondary-subtle text-dark rounded-circle p-1"><i class="bi bi-journal-text"></i></span>
                </div>
                <div class="fs-4 fw-bold text-dark" id="kpiTotal">148 Records</div>
                <div class="text-muted small" style="font-size: 0.78rem;">Across 42 Delivery Orders</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 ls-card border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-secondary small fw-semibold text-uppercase">Matched &amp; Balanced</span>
                    <span class="badge bg-success-subtle text-success rounded-circle p-1"><i class="bi bi-check2-circle"></i></span>
                </div>
                <div class="fs-4 fw-bold text-success" id="kpiMatched">132 (89.2%)</div>
                <div class="text-success small" style="font-size: 0.78rem;">Zero-Discrepancy Invariant</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 ls-card border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-secondary small fw-semibold text-uppercase">Weight / Rate Variances</span>
                    <span class="badge bg-warning-subtle text-warning rounded-circle p-1"><i class="bi bi-exclamation-triangle"></i></span>
                </div>
                <div class="fs-4 fw-bold text-warning" id="kpiVariances">11 (7.4%)</div>
                <div class="text-secondary small" style="font-size: 0.78rem;">Transit &amp; Rate Delta Breaks</div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 ls-card border-start border-4 border-danger">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-secondary small fw-semibold text-uppercase">Missing / Unmatched</span>
                    <span class="badge bg-danger-subtle text-danger rounded-circle p-1"><i class="bi bi-x-octagon"></i></span>
                </div>
                <div class="fs-4 fw-bold text-danger" id="kpiMissing">5 (3.4%)</div>
                <div class="text-secondary small" style="font-size: 0.78rem;">Missing in Counterparty Book</div>
            </div>
        </div>
    </div>

    <!-- Drag-and-Drop Statement Ingestion Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 ls-card overflow-hidden">
        <div class="card-header bg-dark text-white px-4 py-3 border-0 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="navbar-brand-badge" style="width: 28px; height: 28px; font-size: 0.85rem;">
                    <i class="bi bi-cloud-arrow-up"></i>
                </span>
                <span class="fw-semibold small text-uppercase tracking-wider">Statement Ingestion &amp; Batch Feed Intake</span>
            </div>
            <span class="badge bg-info-subtle text-info border border-info-subtle small ls-code-badge">CSV &bull; XLSX &bull; EDI &bull; MT940</span>
        </div>

        <div class="card-body p-4 bg-white">
            <form method="post" asp-controller="Reconciliation" asp-action="Index" enctype="multipart/form-data" id="statementUploadForm">
                
                <div class="row g-4 align-items-center">
                    
                    <!-- Drag and Drop Dropzone -->
                    <div class="col-12 col-lg-8">
                        <div class="p-4 p-md-5 rounded-4 border-2 border-dashed text-center position-relative transition-all" id="dropZone" style="border: 2px dashed #94a3b8; background-color: #f8fafc; cursor: pointer;">
                            <input type="file" id="statementFileInput" name="StatementFile" class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" accept=".csv, .xlsx, .xls, .edi, .xml, .txt" />
                            
                            <div class="d-flex flex-column align-items-center justify-content-center">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 mb-3" style="width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-cloud-arrow-up-fill fs-2"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-1" id="dropZoneTitle">Drag &amp; Drop Counterparty Statements Here</h5>
                                <p class="text-secondary small mb-3" id="dropZoneSubtitle">
                                    Drop seller bills of lading, buyer weighbridge receipts, or ERP extracts (CSV, XLSX, MT940) or <span class="text-primary fw-semibold text-decoration-underline">Browse Files</span>
                                </p>
                                <div class="d-flex flex-wrap justify-content-center gap-2 small text-muted">
                                    <span class="badge bg-light text-secondary border px-2 py-1"><i class="bi bi-filetype-csv me-1"></i> Party A Dispatch.csv</span>
                                    <span class="badge bg-light text-secondary border px-2 py-1"><i class="bi bi-filetype-xlsx me-1"></i> Party B Inward.xlsx</span>
                                    <span class="badge bg-light text-secondary border px-2 py-1"><i class="bi bi-file-earmark-code me-1"></i> EDI-214 / EDI-856</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ingestion Controls & Demo Data Loader -->
                    <div class="col-12 col-lg-4">
                        <div class="p-3 rounded-4 bg-light border border-secondary border-opacity-25 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-gear-wide-connected text-primary"></i>
                                    <span>Ingestion Parameters</span>
                                </h6>
                                
                                <div class="mb-3">
                                    <label for="scopeParty" class="form-label text-secondary small mb-1 fw-semibold">Target Counterparty</label>
                                    <select class="form-select form-select-sm bg-white" id="scopeParty">
                                        <option value="ALL">All Counterparties (Global Reconciliation)</option>
                                        <option value="ALPHA" selected>Sabir Vegetable Oil (Seller Book)</option>
                                        <option value="APEX">Faisal Feeds (Buyer Book)</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="toleranceTolerance" class="form-label text-secondary small mb-1 fw-semibold">Transit Weight Tolerance</label>
                                    <select class="form-select form-select-sm bg-white" id="toleranceTolerance">
                                        <option value="0.25">0.25% Normal Moisture / Tare Tolerance</option>
                                        <option value="0.50" selected>0.50% Standard Bulk Commodity Tolerance</option>
                                        <option value="1.00">1.00% High Dispersion Tolerance</option>
                                    </select>
                                </div>
                            </div>

                            <div class="d-grid gap-2 pt-2">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold py-2 d-flex align-items-center justify-content-center gap-2" id="btnSimulateSample">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span>Reload Bilateral Batch Data</span>
                                </button>
                                <button type="submit" class="btn btn-primary btn-sm rounded-pill fw-semibold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                    <span>Run Invariant Engine</span>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

            </form>
        </div>
    </div>

    <!-- Split-Screen Discrepancy Table Preview -->
    <div class="card border-0 shadow-sm rounded-4 ls-card overflow-hidden">
        
        <!-- Table Controls & Filter Bar -->
        <div class="card-header bg-dark text-white p-3 p-md-4 border-0">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                
                <div>
                    <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
                        <span>Split-Screen Discrepancy Preview</span>
                        <span class="badge bg-secondary-subtle text-light ls-code-badge">FY 2026-2027</span>
                    </h5>
                    <div class="text-secondary small">
                        Side-by-side ledger verification comparing Seller Dispatched Records vs. Buyer Received Records.
                    </div>
                </div>

                <!-- Interactive Filter Buttons -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="btn-group btn-group-sm p-1 bg-black bg-opacity-40 rounded-pill border border-secondary border-opacity-25" role="group">
                        <button type="button" class="btn btn-sm text-white rounded-pill px-3 active filter-btn" data-filter="all">
                            All (<span id="countAll">148</span>)
                        </button>
                        <button type="button" class="btn btn-sm text-white rounded-pill px-3 filter-btn" data-filter="matched">
                            <span class="text-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i></span> Matched (132)
                        </button>
                        <button type="button" class="btn btn-sm text-white rounded-pill px-3 filter-btn" data-filter="variance">
                            <span class="text-warning"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i></span> Variances (11)
                        </button>
                        <button type="button" class="btn btn-sm text-white rounded-pill px-3 filter-btn" data-filter="missing">
                            <span class="text-danger"><i class="bi bi-circle-fill me-1" style="font-size: 0.6rem;"></i></span> Missing (5)
                        </button>
                    </div>

                    <!-- Search Box -->
                    <div class="input-group input-group-sm" style="width: 220px;">
                        <span class="input-group-text bg-black bg-opacity-40 border-secondary border-opacity-25 text-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control bg-black bg-opacity-40 border-secondary border-opacity-25 text-white" id="searchTableInput" placeholder="Filter D.O. or Truck..." />
                    </div>
                </div>

            </div>
        </div>

        <!-- Discrepancy Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="discrepancyTable">
